---
// One post: /blog/<slug>/. Drafts render in dev only.
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { url, fmtDate } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => import.meta.env.DEV || !e.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <h1>{post.data.title}</h1>
  <p class="meta"><time datetime={fmtDate(post.data.date)}>{fmtDate(post.data.date)}</time>{post.data.updated && <> · updated <time datetime={fmtDate(post.data.updated)}>{fmtDate(post.data.updated)}</time></>}</p>
  <Content />
  <p class="meta"><a href={url('/#posts')}>All posts</a></p>
</Base>
